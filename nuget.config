<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pinned because this repository uses central package management, and CPM refuses
       to restore when more than one source is visible without a source mapping. Every
       source configured on the developer's machine is otherwise inherited, so whether
       the build works depended on what else that machine happened to have set up.
       `clear` makes it depend on this file instead. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
